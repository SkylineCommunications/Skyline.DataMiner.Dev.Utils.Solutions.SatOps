<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AssemblyName>Skyline.DataMiner.Dev.Utils.Solutions.SatOps.Common</AssemblyName>
		<RootNamespace>Skyline.DataMiner.SDM.SatOps.Common</RootNamespace>
		<Copyright>Copyright © 2026</Copyright>
		<PackageTags>Skyline;DataMiner</PackageTags>
		<PackageProjectUrl>https://skyline.be</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>Icon.png</PackageIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>SkylineCommunications</Authors>
		<Company>Skyline Communications</Company>
		<Description>DevPack for the SatOps Solution</Description>
		<Version>0.0.7</Version>
		<PackageReleaseNotes>Fixed: Satellites.Initialize() (and equivalents for Transponder, TransponderSlot, TransponderPlan, TransponderPlanRow, TransponderRangeReservation, Beam) threw "'SatelliteName' is required" (and equivalent messages) due to premature required-field validation being triggered during Clone(). *Instance.Clone() and Duplicate() now clone the underlying DomInstance directly and no longer route through ToInstance()/ToSection(); required-field validation still fires on Save/Create/Update. Additionally fixed: property getters on Satellite, Beam, Transponder, TransponderSlot, TransponderPlan, and TransponderPlanRow now return the value written by their setter for freshly-initialized objects (getters previously read from the original instance while setters wrote to the updated instance, causing middleware validators to see a null Name/Abbreviation/... even after the caller set it).</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="nuget\Icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Skyline.DataMiner.CICD.CSharpAnalysis.Analyzer" Version="2.1.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Skyline.DataMiner.Dev.Utils.SDM.Abstractions" Version="1.0.1" />
		<PackageReference Include="Skyline.DataMiner.Dev.Utils.Solutions.MediaOps.Plan" Version="1.7.0-alpha002" />
		<PackageReference Include="Skyline.DataMiner.SDM" Version="1.0.1" />
		<PackageReference Include="Skyline.DataMiner.SDM.Registration.Common" Version="2.0.5" />
		<PackageReference Include="Skyline.DataMiner.SDM.SourceGenerator.Runtime" Version="1.0.1" />
		<PackageReference Include="Skyline.DataMiner.Utils.DOM" Version="10.5.2.8" />
		<PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers" Version="2.2.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>

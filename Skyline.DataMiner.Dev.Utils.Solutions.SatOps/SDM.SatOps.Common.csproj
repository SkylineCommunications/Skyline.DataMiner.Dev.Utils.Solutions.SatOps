<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AssemblyName>Skyline.DataMiner.Dev.Utils.Solutions.SatOps.Common</AssemblyName>
		<RootNamespace>Skyline.DataMiner.SDM.SatOps.Common</RootNamespace>
		<Copyright>Copyright © 2026</Copyright>
		<PackageTags>Skyline;DataMiner</PackageTags>
		<PackageProjectUrl>https://skyline.be</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageIcon>Icon.png</PackageIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Authors>SkylineCommunications</Authors>
		<Company>Skyline Communications</Company>
		<Description>DevPack for the SatOps Solution</Description>
		<Version>0.1.5</Version>
		<PackageReleaseNotes>0.1.3: Transponder names are now enforced to be globally unique (case-insensitive) by the API instead of only by the calling scripts. Because every Transponder provisions a MediaOps Plan resource with the same name, and DataMiner rejects duplicate resource names, the check runs before any resource is provisioned. The resource name is additionally verified against the existing resources (catching orphans and resources owned by other solutions) and on rename. If persisting a Transponder fails after its resource was created, the resource is now rolled back instead of being orphaned. 0.1.2: Deleting a Transponder now also removes the satellite discrete it added to the shared "Satellite" capability (profile parameter), but only when no remaining resource still references that satellite. This prevents leaked satellite profile parameters after transponder cleanup. 0.1.1: Deleting a Transponder now also cleans up the MediaOps Plan resource that was auto-provisioned for it (previously orphaned). The resource is deprecated and then deleted; if the delete is blocked by active bookings it is left deprecated and logged. Cleanup runs for every delete overload, including delete-by-id. 0.1.0: SlotName is persisted automatically on TransponderRangeReservation Create/Update; the AddSlotNameProperty helper is no longer exposed on ITransponderRangeReservationRepository or its middleware. ReserveRange overloads remain public. Reads hydrate SlotName back onto the reservation.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="nuget\Icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Skyline.DataMiner.CICD.CSharpAnalysis.Analyzer" Version="2.1.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Skyline.DataMiner.Dev.Utils.SDM.Abstractions" Version="1.0.1" />
		<PackageReference Include="Skyline.DataMiner.Dev.Utils.Solutions.MediaOps.Plan" Version="1.7.0-alpha005" />
		<PackageReference Include="Skyline.DataMiner.SDM" Version="1.0.1" />
		<PackageReference Include="Skyline.DataMiner.SDM.Registration.Common" Version="2.0.5" />
		<PackageReference Include="Skyline.DataMiner.SDM.SourceGenerator.Runtime" Version="1.0.1" />
		<PackageReference Include="Skyline.DataMiner.Utils.DOM" Version="10.5.2.8" />
		<PackageReference Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers" Version="2.2.3">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
		Central Package Management (CPM) — single source of truth for every NuGet package version used in this repo.

		When CPM is enabled, individual project .csproj files declare package references as
		<PackageReference Include="Foo" />  (without a Version attribute); the version is resolved from the
		<PackageVersion Include="Foo" Version="..."/> entries below.
	-->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Multiple NuGet sources are configured; source-mapping is not enforced here. -->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="MSTest.TestAdapter" Version="3.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="3.5.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Skyline.DataMiner.CICD.CSharpAnalysis.Analyzer" Version="2.1.2" />
    <PackageVersion Include="Skyline.DataMiner.Dev.Protocol" Version="10.5.11.1" />
    <PackageVersion Include="Skyline.DataMiner.Dev.Utils.SDM.Abstractions" Version="1.0.1" />
    <PackageVersion Include="Skyline.DataMiner.Dev.Utils.Solutions.MediaOps.Plan" Version="1.7.0-alpha013" />
    <PackageVersion Include="Skyline.DataMiner.SDM" Version="1.0.1" />
    <PackageVersion Include="Skyline.DataMiner.SDM.Registration.Common" Version="2.0.5" />
    <PackageVersion Include="Skyline.DataMiner.SDM.SourceGenerator.Runtime" Version="1.0.1" />
    <PackageVersion Include="Skyline.DataMiner.Utils.DOM" Version="10.5.2.8" />
    <PackageVersion Include="Skyline.DataMiner.Utils.SecureCoding.Analyzers" Version="2.2.3" />
  </ItemGroup>
</Project>
